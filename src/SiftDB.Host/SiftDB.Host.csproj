<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Program.Main runs Velopack's install and update hooks before WPF starts (design section 9). -->
    <StartupObject>SiftDB.Host.Program</StartupObject>
    <AssemblyName>SiftDB</AssemblyName>
    <Product>SiftDB</Product>
    <!-- The version a local build reports. A release passes its own (-p:Version=..., from the git tag). -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SiftDB.Engine\SiftDB.Engine.csproj" />
    <ProjectReference Include="..\SiftDB.Bridge\SiftDB.Bridge.csproj" />
    <!-- Spike: referenced directly. Real plugin loading (AssemblyLoadContext) comes later. -->
    <ProjectReference Include="..\SiftDB.Providers.Postgres\SiftDB.Providers.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!--
    The bundled UI (served locally, never from a remote URL). The .NET build runs the npm build itself:
    `npm install` + `npm run build` whenever a UI source file is newer than dist/index.html, then the
    bundle is copied to the output under ui/. Pass -p:SkipUiBuild=true to skip (e.g. CI that built it already).
  -->
  <PropertyGroup>
    <UiDir>$(MSBuildProjectDirectory)\..\ui\</UiDir>
  </PropertyGroup>

  <ItemGroup>
    <UiSource Include="$(UiDir)src\**;$(UiDir)index.html;$(UiDir)package.json;$(UiDir)vite.config.ts;$(UiDir)tsconfig.json" />
  </ItemGroup>

  <Target Name="BuildUi" BeforeTargets="AssignTargetPaths;BeforeBuild" Inputs="@(UiSource)" Outputs="$(UiDir)dist\index.html" Condition="'$(SkipUiBuild)' != 'true'">
    <Exec Command="npm install" WorkingDirectory="$(UiDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(UiDir)" />
  </Target>

  <!-- Separate target so the bundle is picked up even when dist/ didn't exist at evaluation time. -->
  <Target Name="IncludeUi" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildUi">
    <ItemGroup>
      <UiOutput Include="$(UiDir)dist\**" />
      <Content Include="@(UiOutput)" Link="ui\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
