<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- A plugin (design section 14, F18): loaded from providers\postgres\ into a load context of its own. -->
    <SiftDBProviderId>postgres</SiftDBProviderId>
    <SiftDBProviderName>PostgreSQL</SiftDBProviderName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The app's own copy is used, never one next to the provider. -->
    <ProjectReference Include="..\SiftDB.Abstractions\SiftDB.Abstractions.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="pgsqlparser" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SiftDB.Providers.Postgres.Tests" />
  </ItemGroup>

  <Import Project="..\..\build\SiftDB.Provider.targets" />

</Project>
